APP_NAME=YouTube Shorts Automation Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/shorts.db
YOUTUBE_API_KEY=
YOUTUBE_REQUEST_TIMEOUT_SECONDS=10
YOUTUBE_MAX_QUERIES_PER_REQUEST=5
SUPPORTED_CATEGORIES_CSV=celebrities,music,rap,documentaries,animation,gaming,education,comedy,sports,children
RANKING_RECENCY_WEIGHT=0.20
RANKING_VIEWS_WEIGHT=0.45
RANKING_ENGAGEMENT_WEIGHT=0.25
RANKING_VELOCITY_WEIGHT=0.10
RANKING_RECENCY_HALF_LIFE_DAYS=7
RANKING_VIEWS_PER_DAY_REFERENCE=100000
RANKING_ENGAGEMENT_REFERENCE=0.05
RANKING_MIN_VELOCITY_INTERVAL_HOURS=1
SOURCE_MEDIA_DIRECTORY=./data/media
GENERATION_OUTPUT_DIRECTORY=./data/outputs
MAX_SOURCE_FILE_MB=500
MAX_OUTPUT_FILE_MB=1000
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=20
DEFAULT_SHORT_DURATION_SECONDS=45
MAX_SHORT_DURATION_SECONDS=180
VIDEO_ASPECT_RATIO=9:16
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=23
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
CAPTION_FONT_NAME=DejaVu Sans
CAPTION_FONT_SIZE=48
CAPTION_MARGIN_VERTICAL=120
CAPTION_OUTLINE_SIZE=3
CAPTION_PRIMARY_COLOR=&H00FFFFFF
CAPTION_OUTLINE_COLOR=&H00000000
NARRATION_PROVIDER=none
NARRATION_VOICE=en
NARRATION_SPEED=165
ESPEAK_BINARY=espeak-ng
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_GENERATION_ATTEMPTS=3
CATEGORY_TEMPLATES={}